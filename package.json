{
  "name": "claudsidian",
  "version": "2.0.4",
  "description": "Talk to your Claude Code sessions from any device over Remote Control, with your open notes as context.",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "mock-ccr": "node test/mock-ccr/server.mjs",
    "harness:build": "node e2e/harness/build.mjs",
    "install:vault": "bash scripts/install-to-vault.sh",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@preact/signals": "^2.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "marked": "^15.0.0",
    "obsidian": "latest",
    "playwright": "^1.64.0",
    "preact": "^10.27.0",
    "tslib": "^2.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
